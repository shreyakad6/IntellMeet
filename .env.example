# ============================================================
# IntellMeet Environment Configuration
# ============================================================

# General Server Settings
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/intellmeet

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_development_change_in_production_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_for_development_32chars
JWT_REFRESH_EXPIRES_IN=30d

# AI Integration (Free-Tier Providers: Google Gemini + Groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Legacy / Optional Fallback (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEMO_MODE=false

# Cache & Session (Redis - optional for local dev, auto-fallback to in-memory)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# File Storage (Optional Cloudinary / AWS S3 - falls back to local disk storage)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Monitoring & Error Reporting (Optional)
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
